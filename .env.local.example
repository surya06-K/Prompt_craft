# Copy to .env.local only if you want local dev to use a real database.
# Without these, `npm run dev` stores data in .data/db.json.
# On Vercel, connecting Upstash Redis under Storage sets KV_REST_API_URL / KV_REST_API_TOKEN for you.

UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here
